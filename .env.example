# ===== 数据库 =====
# 应用连接(角色 lp_app, NOBYPASSRLS, 由迁移 0001 创建并授权)
# 宿主机端口 55432(避开本机常见 5432 占用)
DATABASE_URL=postgresql://lp_app:lp@localhost:55432/lp
# 迁移连接(需要建表/建角色权限)
MIGRATE_DATABASE_URL=postgresql://postgres:lp@localhost:55432/lp
MIGRATIONS_DIR=db/migrations

# ===== 码与加密 =====
CODE_HMAC_KEY=dev-code-hmac-key-change-me
FINGERPRINT_PEPPER=dev-fp-pepper
CODE_ENC_KEY=dev-code-enc-key-change-me

# ===== 签名 =====
SIGNER_PROVIDER=local
SIGNER_LOCAL_SEED=dev-signer-seed-change-me
SIGNER_ACTIVE_KID=dev-2026-01

# ===== 授权默认值 =====
OFFLINE_DEFAULT_WINDOW_DAYS=7
HEARTBEAT_DEFAULT_HOURS=24
CLIENT_TOKEN_TTL_HOURS=24
CLIENT_TOKEN_OVERLAP_MIN=5

# ===== 发码 =====
BATCH_SYNC_THRESHOLD=10000
BATCH_CHUNK_SIZE=2000
BATCH_MAX_QUANTITY=100000
EXPORT_DIR=./data/exports

# ===== 骨架期认证(P2 换成真实 JWT/RBAC/API Key) =====
ADMIN_DEV_TOKEN=dev-admin-token
ADMIN_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
OPEN_DEV_API_KEY=lpk_dev_demo
OPEN_DEV_TENANT_ID=11111111-1111-4111-8111-111111111111

# ===== 校验缓存(进程内, P3 换 Redis) =====
VALIDATE_CACHE_TTL_S=60

# ===== 服务端口 =====
PORT_ADMIN=3001
PORT_CLIENT=3002
PORT_OPEN=3003
LOG_LEVEL=info

# ===== 端口(门户) =====
PORT_PORTAL=3004

# ===== 通知通道(邮件/短信) =====
# 未配置 SMTP_* / SMS_GATEWAY_URL 时: dev/test 回落到控制台出口(仅日志), prod 置 blocked
# 生产必须配置真实网关, 并显式关闭控制台兜底
NOTIFY_ADDR_ENC_KEY=dev-notify-addr-enc-key-change-me
# 留空: dev/test 自动回落控制台出口, prod 自动关闭(置 blocked)
# 生产显式设 true 只用于演练; 设为 false 可强制要求真实网关
NOTIFY_CONSOLE_FALLBACK=
# /metrics 抓取令牌: 配置后须带 Authorization: Bearer <token>; 生产不配则不暴露
METRICS_TOKEN=
# TOTP 密钥的加密密钥(两步验证), 生产环境务必更换
MFA_SECRET_ENC_KEY=dev-mfa-secret-enc-key-change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@license-platform.local
# starttls(587) | implicit(465)
SMTP_TLS_MODE=starttls
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
